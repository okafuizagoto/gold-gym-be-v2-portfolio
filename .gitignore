# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

*.json
!package.json
# air hot-reload (binary sementara)
tmp/

# Binary hasil build lokal -- Dockerfile build binary-nya sendiri
# (`go build -o main ./cmd/http`) dan air build ke tmp/, jadi ini cuma
# artefak lokal yang tidak perlu ikut commit (ketemu 89MB ke-commit gara-gara
# folder ini tidak di-gitignore, bikin clone/checkout Jenkins lebih berat).
bin/
